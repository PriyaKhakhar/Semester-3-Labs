## Lab 6 — All Queries Together (MySQL)

```sql
-- LAB 6: PERFORM SQL QUERIES FOR DATA COPY (SELECT INTO)

-- PART A: From DEPOSIT table

-- 1. Copy all records from DEPOSIT where AMOUNT > 3000
CREATE TABLE HIGH_AMOUNT AS
SELECT *
FROM DEPOSIT
WHERE AMOUNT > 3000;

-- 2. Copy only CNAME and AMOUNT where BNAME = 'MAVDI'
CREATE TABLE MAVDI_CUSTOMERS AS
SELECT CNAME, AMOUNT
FROM DEPOSIT
WHERE BNAME = 'MAVDI';

-- 3. Copy records where ADATE > '2025-01-01'
CREATE TABLE RECENT_DEPOSITS AS
SELECT *
FROM DEPOSIT
WHERE ADATE > '2025-01-01';

-- 4. Copy distinct BNAME
CREATE TABLE UNIQUE_BRANCH AS
SELECT DISTINCT BNAME
FROM DEPOSIT;

-- 5. Copy top 5 records from DEPOSIT
CREATE TABLE TOP_DEPOSITS AS
SELECT *
FROM DEPOSIT
LIMIT 5;

-- 6. Copy records where AMOUNT is between 2000 and 6000
CREATE TABLE MID_RANGE AS
SELECT *
FROM DEPOSIT
WHERE AMOUNT BETWEEN 2000 AND 6000;

-- 7. Copy distinct branch names
CREATE TABLE UNIQUE_BRANCH_NAMES AS
SELECT DISTINCT BNAME
FROM DEPOSIT;

-- 8. Copy records with NULL branch
CREATE TABLE NO_BRANCH_ASSIGNED AS
SELECT *
FROM DEPOSIT
WHERE BNAME IS NULL;

-- 9. Copy all records and rename AMOUNT as BALANCE
CREATE TABLE DEPOSIT_COPY AS
SELECT CNAME, BNAME, ADATE, AMOUNT AS BALANCE
FROM DEPOSIT;

-- 10. Copy records where BNAME = 'MAVDI'
CREATE TABLE SELECTED_BRANCH AS
SELECT *
FROM DEPOSIT
WHERE BNAME = 'MAVDI';


-- PART B: From STUDENT table

-- 11. Create a new table STUDENT_BACKUP without copying any data
CREATE TABLE STUDENT_BACKUP AS
SELECT *
FROM STUDENT
WHERE 1 = 0;

-- 12. Copy SNAME and CITY where BRANCH = 'COMPUTER'
CREATE TABLE CS_STUDENTS AS
SELECT SNAME, CITY
FROM STUDENT
WHERE BRANCH = 'COMPUTER';

-- 13. Copy top 3 students based on SPI
CREATE TABLE TOPPER_LIST AS
SELECT *
FROM STUDENT
ORDER BY SPI DESC
LIMIT 3;

-- 14. Copy distinct CITY
CREATE TABLE CITY_LIST AS
SELECT DISTINCT CITY
FROM STUDENT;

-- 15. Copy records where STDID is between 103 and 108
CREATE TABLE MID_STUDENTS AS
SELECT *
FROM STUDENT
WHERE STDID BETWEEN 103 AND 108;

-- 16. Copy records with NULL branch
CREATE TABLE NULL_BRANCH_STUDENTS AS
SELECT *
FROM STUDENT
WHERE BRANCH IS NULL;

-- 17. Copy all STUDENT records and rename SPI as PERFORMANCE
CREATE TABLE STUDENT_COPY AS
SELECT STDID, SNAME, BRANCH, CITY, SPI AS PERFORMANCE
FROM STUDENT;

-- 18. Copy records where CITY is 'RAJKOT' or 'SURAT'
CREATE TABLE CITY_WISE AS
SELECT *
FROM STUDENT
WHERE CITY IN ('RAJKOT', 'SURAT');

-- 19. Copy students where BRANCH <> 'CIVIL'
CREATE TABLE NON_CIVIL_STUDENTS AS
SELECT *
FROM STUDENT
WHERE BRANCH <> 'CIVIL';

-- 20. Copy selected columns into a new table
CREATE TABLE STUDENT_NEW AS
SELECT SNAME, CITY, SPI
FROM STUDENT;
```
