-- 8. Create AUTHOR table with given constraints.

CREATE TABLE AUTHOR
(
    AUTHORID INT PRIMARY KEY,
    AUTHORNAME VARCHAR(100) NOT NULL,
    COUNTRY VARCHAR(50) NULL
);


-- 9. Create BOOK table with given constraints.

