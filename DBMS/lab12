    PUBLISHERID INT NOT NULL
        FOREIGN KEY REFERENCES PUBLISHER(PUBLISHERID),
    PRICE DECIMAL(8,2) NOT NULL,
    PUBLICATIONYEAR INT NOT NULL
);


