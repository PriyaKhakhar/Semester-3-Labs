/* =========================================================
   LAB 18 : SUBQUERIES
   ========================================================= */

/* PART - A */

/* 1. Students whose SPI is greater than average SPI */
SELECT *
FROM STUDENT
WHERE SPI > (SELECT AVG(SPI) FROM STUDENT);


/* 2. Names of students whose SPI is less than average SPI */
SELECT SNAME
FROM STUDENT
WHERE SPI < (SELECT AVG(SPI) FROM STUDENT);


/* 3. Student having highest SPI */
SELECT *
FROM STUDENT
WHERE SPI = (SELECT MAX(SPI) FROM STUDENT);


/* 4. Student having lowest SPI */
SELECT *
FROM STUDENT
WHERE SPI = (SELECT MIN(SPI) FROM STUDENT);


/* 5. Students whose SPI is greater than DHARMIK */
SELECT *
FROM STUDENT
WHERE SPI > (SELECT SPI FROM STUDENT WHERE SNAME = 'DHARMIK');


/* 6. Students whose SPI is less than RIYA */
SELECT *
FROM STUDENT
WHERE SPI < (SELECT SPI FROM STUDENT WHERE SNAME = 'RIYA');


/* 7. Students having same branch as KRUNAL */
SELECT *
FROM STUDENT
WHERE BRANCH = (SELECT BRANCH FROM STUDENT WHERE SNAME = 'KRUNAL');


/* 8. Students having different branch from HETVI */
SELECT *
FROM STUDENT
WHERE BRANCH <> (SELECT BRANCH FROM STUDENT WHERE SNAME = 'HETVI');


/* 9. Second highest SPI from RESULT */
SELECT MAX(SPI) AS Second_Highest_SPI
FROM RESULT
WHERE SPI < (SELECT MAX(SPI) FROM RESULT);


/* 10. Second lowest SPI from RESULT */
SELECT MIN(SPI) AS Second_Lowest_SPI
FROM RESULT
WHERE SPI > (SELECT MIN(SPI) FROM RESULT);


/* 11. Students whose SPI is above branch-wise average */
SELECT SNAME
FROM STUDENT S
WHERE SPI > (
    SELECT AVG(SPI)
    FROM STUDENT
    WHERE BRANCH = S.BRANCH
);


/* 12. Branch having maximum average SPI */
SELECT BRANCH
FROM STUDENT
GROUP BY BRANCH
HAVING AVG(SPI) = (
    SELECT MAX(AVG_SPI)
    FROM (
        SELECT AVG(SPI) AS AVG_SPI
        FROM STUDENT
        GROUP BY BRANCH
    ) A
);


/* 13. Branch having minimum average SPI */
SELECT BRANCH
FROM STUDENT
GROUP BY BRANCH
HAVING AVG(SPI) = (
    SELECT MIN(AVG_SPI)
    FROM (
        SELECT AVG(SPI) AS AVG_SPI
        FROM STUDENT
        GROUP BY BRANCH
    ) A
);


/* PART - B */

/* 14. Students whose SPI is greater than ALL ME students */
SELECT *
FROM STUDENT_INFO S
JOIN RESULT R ON S.RNO = R.RNO
WHERE R.SPI > ALL (
    SELECT R2.SPI
    FROM STUDENT_INFO S2
    JOIN RESULT R2 ON S2.RNO = R2.RNO
    WHERE S2.BRANCH = 'ME'
);


/* 15. Students whose SPI is less than ANY ME student */
SELECT *
FROM STUDENT_INFO S
JOIN RESULT R ON S.RNO = R.RNO
WHERE R.SPI < ANY (
    SELECT R2.SPI
    FROM STUDENT_INFO S2
    JOIN RESULT R2 ON S2.RNO = R2.RNO
    WHERE S2.BRANCH = 'ME'
);


/* 16. Students whose SPI is not equal to EC students */
SELECT *
FROM STUDENT_INFO S
JOIN RESULT R ON S.RNO = R.RNO
WHERE R.SPI NOT IN (
    SELECT R2.SPI
    FROM STUDENT_INFO S2
    JOIN RESULT R2 ON S2.RNO = R2.RNO
    WHERE S2.BRANCH = 'EC'
);


/* 17. Students having SPI higher than RNO 103 */
SELECT S.NAME
FROM STUDENT_INFO S
JOIN RESULT R ON S.RNO = R.RNO
WHERE R.SPI > (
    SELECT SPI
    FROM RESULT
    WHERE RNO = 103
);


/* 18. Students whose SPI is greater than their branch average */
SELECT S.NAME, S.BRANCH, R.SPI
FROM STUDENT_INFO S
JOIN RESULT R ON S.RNO = R.RNO
WHERE R.SPI > (
    SELECT AVG(R2.SPI)
    FROM STUDENT_INFO S2
    JOIN RESULT R2 ON S2.RNO = R2.RNO
    WHERE S2.BRANCH = S.BRANCH
);


/* 19. SPI greater than CE average AND ME maximum */
SELECT S.NAME, S.BRANCH, R.SPI
FROM STUDENT_INFO S
JOIN RESULT R ON S.RNO = R.RNO
WHERE R.SPI > (
    SELECT AVG(R2.SPI)
    FROM STUDENT_INFO S2
    JOIN RESULT R2 ON S2.RNO = R2.RNO
    WHERE S2.BRANCH = 'CE'
)
AND R.SPI > (
    SELECT MAX(R3.SPI)
    FROM STUDENT_INFO S3
    JOIN RESULT R3 ON S3.RNO = R3.RNO
    WHERE S3.BRANCH = 'ME'
);


/* 20. Branches whose average SPI is greater than overall average */
SELECT S.BRANCH
FROM STUDENT_INFO S
JOIN RESULT R ON S.RNO = R.RNO
GROUP BY S.BRANCH
HAVING AVG(R.SPI) > (
    SELECT AVG(SPI)
    FROM RESULT
);


/* 21. Students having maximum SPI in their branch */
SELECT S.NAME, S.BRANCH, R.SPI
FROM STUDENT_INFO S
JOIN RESULT R ON S.RNO = R.RNO
WHERE R.SPI = (
    SELECT MAX(R2.SPI)
    FROM STUDENT_INFO S2
    JOIN RESULT R2 ON S2.RNO = R2.RNO
    WHERE S2.BRANCH = S.BRANCH
);


/* 22. SPI greater than branch average AND overall average */
SELECT S.NAME, S.BRANCH, R.SPI
FROM STUDENT_INFO S
JOIN RESULT R ON S.RNO = R.RNO
WHERE R.SPI > (
    SELECT AVG(R2.SPI)
    FROM STUDENT_INFO S2
    JOIN RESULT R2 ON S2.RNO = R2.RNO
    WHERE S2.BRANCH = S.BRANCH
)
AND R.SPI > (
    SELECT AVG(SPI)
    FROM RESULT
);


/* PART - C */

/* 23. SPI greater than at least one student of every branch */
SELECT S.NAME, S.BRANCH, R.SPI
FROM STUDENT_INFO S
JOIN RESULT R ON S.RNO = R.RNO
WHERE R.SPI > ALL (
    SELECT MIN(R2.SPI)
    FROM STUDENT_INFO S2
    JOIN RESULT R2 ON S2.RNO = R2.RNO
    GROUP BY S2.BRANCH
);


/* 24. SPI less than all CE students */
SELECT S.NAME, S.BRANCH, R.SPI
FROM STUDENT_INFO S
JOIN RESULT R ON S.RNO = R.RNO
WHERE R.SPI < ALL (
    SELECT R2.SPI
    FROM STUDENT_INFO S2
    JOIN RESULT R2 ON S2.RNO = R2.RNO
    WHERE S2.BRANCH = 'CE'
);


/* 25. Branch containing student with highest SPI */
SELECT BRANCH
FROM STUDENT_INFO
WHERE RNO = (
    SELECT RNO
    FROM RESULT
    WHERE SPI = (SELECT MAX(SPI) FROM RESULT)
);


/* 26. SPI less than every CE student and greater than every ME student */
SELECT S.NAME, S.BRANCH, R.SPI
FROM STUDENT_INFO S
JOIN RESULT R ON S.RNO = R.RNO
WHERE R.SPI < ALL (
    SELECT R2.SPI
    FROM STUDENT_INFO S2
    JOIN RESULT R2 ON S2.RNO = R2.RNO
    WHERE S2.BRANCH = 'CE'
)
AND R.SPI > ALL (
    SELECT R3.SPI
    FROM STUDENT_INFO S3
    JOIN RESULT R3 ON S3.RNO = R3.RNO
    WHERE S3.BRANCH = 'ME'
);


/* =========================================================
