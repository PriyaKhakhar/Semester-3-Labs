/* =========================
   LAB 18 - SUBQUERIES
   ========================= */

/* PART A */

/* 1. Students whose SPI is greater than average SPI */
SELECT *
FROM STUDENT
WHERE SPI > (SELECT AVG(SPI) FROM STUDENT);


/* 2. Names of students whose SPI is less than average SPI */
SELECT SNAME
FROM STUDENT
WHERE SPI < (SELECT AVG(SPI) FROM STUDENT);


/* 3. Student having highest SPI */
SELECT *
FROM STUDENT
WHERE SPI = (SELECT MAX(SPI) FROM STUDENT);


/* 4. Student having lowest SPI */
SELECT *
FROM STUDENT
WHERE SPI = (SELECT MIN(SPI) FROM STUDENT);


/* 5. Students whose SPI is greater than DHARMIK */
SELECT *
FROM STUDENT
WHERE SPI > (SELECT SPI FROM STUDENT WHERE SNAME = 'DHARMIK');


/* 6. Students whose SPI is less than RIYA */
SELECT *
FROM STUDENT
WHERE SPI < (SELECT SPI FROM STUDENT WHERE SNAME = 'RIYA');


/* 7. Students having same branch as KRUNAL */
SELECT *
FROM STUDENT
WHERE BRANCH = (SELECT BRANCH FROM STUDENT WHERE SNAME = 'KRUNAL');


/* 8. Students having branch different from HETVI */
SELECT *
FROM STUDENT
WHERE BRANCH <> (SELECT BRANCH FROM STUDENT WHERE SNAME = 'HETVI');


/* 9. Second highest SPI */
SELECT MAX(SPI)
FROM RESULT
WHERE SPI < (SELECT MAX(SPI) FROM RESULT);


/* 10. Second lowest SPI */
SELECT MIN(SPI)
FROM RESULT
WHERE SPI > (SELECT MIN(SPI) FROM RESULT);


/* 11. Students whose SPI is above branch average */
SELECT SNAME
FROM STUDENT S
WHERE SPI > (
    SELECT AVG(SPI)
    FROM STUDENT
    WHERE BRANCH = S.BRANCH
);


/* 12. Branch having maximum average SPI */
SELECT BRANCH
FROM STUDENT
GROUP BY BRANCH
HAVING AVG(SPI) = (
    SELECT MAX(AVG_SPI)
    FROM (
        SELECT AVG(SPI) AS AVG_SPI
        FROM STUDENT
        GROUP BY BRANCH
    ) A
);


/* 13. Branch having minimum average SPI */
SELECT BRANCH
FROM STUDENT
GROUP BY BRANCH
HAVING AVG(SPI) = (
    SELECT MIN(AVG_SPI)
    FROM (
        SELECT AVG(SPI) AS AVG_SPI
        FROM STUDENT
        GROUP BY BRANCH
    ) A
);


/* PART B */

/* 14. SPI greater than all ME students */
SELECT *
FROM STUDENT_INFO S
WHERE SPI > ALL (
    SELECT SPI
    FROM RESULT R
    WHERE R.BRANCH = 'ME'
);


/* 15. SPI less than any ME student */
SELECT *
FROM STUDENT_INFO S
WHERE SPI < ANY (
    SELECT SPI
    FROM RESULT R
    WHERE R.BRANCH = 'ME'
);


/* 16. SPI not equal to any EC student */
SELECT *
FROM STUDENT_INFO S
WHERE SPI NOT IN (
    SELECT SPI
    FROM RESULT
    WHERE BRANCH = 'EC'
);


/* 17. Students having higher SPI than RNO 103 */
SELECT SNAME
FROM STUDENT_INFO S
WHERE SPI > (
    SELECT SPI
    FROM RESULT
    WHERE RNO = 103
);


/* 18. SPI greater than own branch average */
SELECT *
FROM STUDENT_INFO S
WHERE SPI > (
    SELECT AVG(SPI)
    FROM RESULT R
    WHERE R.BRANCH = S.BRANCH
);


/* 19. SPI greater than CE average AND ME maximum */
SELECT *
FROM STUDENT_INFO S
WHERE SPI > (
    SELECT AVG(SPI)
    FROM RESULT
    WHERE BRANCH = 'CE'
)
AND SPI > (
    SELECT MAX(SPI)
    FROM RESULT
    WHERE BRANCH = 'ME'
);


/* 20. Branches whose average SPI is greater than overall average */
SELECT BRANCH
FROM RESULT
GROUP BY BRANCH
HAVING AVG(SPI) > (
    SELECT AVG(SPI)
    FROM RESULT
);


/* 21. Students having maximum SPI in their branch */
SELECT *
FROM STUDENT_INFO S
WHERE SPI = (
    SELECT MAX(SPI)
    FROM RESULT R
    WHERE R.BRANCH = S.BRANCH
);


/* 22. SPI greater than branch average AND overall average */
SELECT *
FROM STUDENT_INFO S
WHERE SPI > (
    SELECT AVG(SPI)
    FROM RESULT R
    WHERE R.BRANCH = S.BRANCH
)
AND SPI > (
    SELECT AVG(SPI)
    FROM RESULT
);


/* PART C */

/* 23. SPI greater than at least one student of every branch */
SELECT *
FROM STUDENT_INFO S
WHERE SPI > ALL (
    SELECT MIN(SPI)
    FROM RESULT
    GROUP BY BRANCH
);


/* 24. SPI less than all CE students */
SELECT *
FROM STUDENT_INFO
WHERE SPI < ALL (
    SELECT SPI
    FROM RESULT
    WHERE BRANCH = 'CE'
);


/* 25. Branch containing student with highest SPI */
SELECT BRANCH
FROM RESULT
WHERE SPI = (
    SELECT MAX(SPI)
    FROM RESULT
);


/* 26. SPI less than every CE student and greater than every ME student */
SELECT *
FROM STUDENT_INFO
WHERE SPI < ALL (
    SELECT SPI
    FROM RESULT
    WHERE BRANCH = 'CE'
)
AND SPI > ALL (
    SELECT SPI
    FROM RESULT
    WHERE BRANCH = 'ME'
);